{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenDidactiaEsquemaProgramacionDidactica",
  "description": "Esquema OKF para la estructuración y validación de Programaciones Didácticas según el modelo canario de 9 Situaciones de Aprendizaje anuales, evaluación continua y planes de refuerzo y recuperación.",
  "type": "object",
  "required": [
    "identificacion",
    "contextualizacion",
    "concrecion_curricular_y_deconstruccion",
    "secuenciacion_anual_9_situaciones_aprendizaje",
    "metodologia_activa_y_dua",
    "evaluacion_criterial_y_calificacion",
    "medidas_de_apoyo_refuerzo_y_recuperacion"
  ],
  "properties": {
    "identificacion": {
      "type": "object",
      "required": [
        "titulo",
        "comunidad_autonoma",
        "etapa",
        "curso",
        "area_o_materia",
        "curso_escolar"
      ],
      "properties": {
        "titulo": { "type": "string" },
        "comunidad_autonoma": {
          "type": "string",
          "enum": ["Canarias", "Madrid", "Andalucía", "Estatal"]
        },
        "centro_educativo": { "type": "string" },
        "etapa": {
          "type": "string",
          "enum": [
            "Educación Infantil",
            "Educación Primaria",
            "Educación Secundaria Obligatoria",
            "Bachillerato",
            "Formación Profesional"
          ]
        },
        "curso": { "type": "string" },
        "area_o_materia": { "type": "string" },
        "departamento_o_equipo": { "type": "string" },
        "profesorado": {
          "type": "array",
          "items": { "type": "string" }
        },
        "curso_escolar": { "type": "string" },
        "horas_semanales": { "type": "integer" }
      }
    },
    "contextualizacion": {
      "type": "object",
      "required": ["entorno_socioeducativo", "caracteristicas_del_grupo"],
      "properties": {
        "entorno_socioeducativo": { "type": "string" },
        "caracteristicas_del_grupo": { "type": "string" },
        "evaluacion_inicial_punto_de_partida": { "type": "string" }
      }
    },
    "concrecion_curricular_y_deconstruccion": {
      "type": "object",
      "required": [
        "competencias_especificas",
        "criterios_evaluacion_y_ponderacion",
        "saberes_basicos_anuales"
      ],
      "properties": {
        "competencias_especificas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["codigo", "enunciado"],
            "properties": {
              "codigo": { "type": "string" },
              "enunciado": { "type": "string" }
            }
          }
        },
        "criterios_evaluacion_y_ponderacion": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["codigo", "enunciado", "ponderacion_porcentual"],
            "properties": {
              "codigo": { "type": "string" },
              "enunciado": { "type": "string" },
              "ponderacion_porcentual": { "type": "number" }
            }
          }
        },
        "saberes_basicos_anuales": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bloque", "saberes"],
            "properties": {
              "bloque": { "type": "string" },
              "saberes": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "secuenciacion_anual_9_situaciones_aprendizaje": {
      "type": "object",
      "description": "Las 9 Situaciones de Aprendizaje canónicas distribuidas en 3 evaluaciones trimestrales.",
      "required": [
        "primera_evaluacion_septiembre_diciembre",
        "segunda_evaluacion_enero_marzo",
        "tercera_evaluacion_abril_junio"
      ],
      "properties": {
        "primera_evaluacion_septiembre_diciembre": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "description": "SAs 1, 2 y 3.",
          "items": { "$ref": "#/definitions/SA_Resumen" }
        },
        "segunda_evaluacion_enero_marzo": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "description": "SAs 4, 5 y 6.",
          "items": { "$ref": "#/definitions/SA_Resumen" }
        },
        "tercera_evaluacion_abril_junio": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "description": "SAs 7, 8 y 9.",
          "items": { "$ref": "#/definitions/SA_Resumen" }
        }
      }
    },
    "metodologia_activa_y_dua": {
      "type": "object",
      "required": ["modelos_ensenanza", "principios_merrill", "despliegue_dua"],
      "properties": {
        "modelos_ensenanza": {
          "type": "array",
          "items": { "type": "string" }
        },
        "principios_merrill": { "type": "string" },
        "despliegue_dua": { "type": "string" },
        "recursos_y_espacios": { "type": "string" }
      }
    },
    "evaluacion_criterial_y_calificacion": {
      "type": "object",
      "required": [
        "caracter_formativo_continuo",
        "instrumentos_rubricas_propias",
        "criterios_de_calificacion_trimestral_y_final"
      ],
      "properties": {
        "caracter_formativo_continuo": { "type": "string" },
        "instrumentos_rubricas_propias": { "type": "string" },
        "criterios_de_calificacion_trimestral_y_final": { "type": "string" },
        "evaluacion_practica_docente": { "type": "string" }
      }
    },
    "medidas_de_apoyo_refuerzo_y_recuperacion": {
      "type": "object",
      "required": [
        "plan_apoyo_refuerzo_evaluacion_continua",
        "plan_recuperacion_materias_pendientes"
      ],
      "properties": {
        "plan_apoyo_refuerzo_evaluacion_continua": {
          "type": "string",
          "description": "Pautas del Centro de Desarrollo Curricular con seguimiento invisible y datos anonimizados."
        },
        "plan_recuperacion_materias_pendientes": { "type": "string" }
      }
    }
  },
  "definitions": {
    "SA_Resumen": {
      "type": "object",
      "required": [
        "numero",
        "titulo",
        "sesiones_estimadas",
        "criterios_evaluacion_vinculados",
        "efemeride_o_plan_centro",
        "instrumentos_evaluacion_productos"
      ],
      "properties": {
        "numero": { "type": "integer" },
        "titulo": { "type": "string" },
        "sesiones_estimadas": { "type": "integer" },
        "criterios_evaluacion_vinculados": {
          "type": "array",
          "items": { "type": "string" }
        },
        "efemeride_o_plan_centro": { "type": "string" },
        "instrumentos_evaluacion_productos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reto_o_producto_final": { "type": "string" }
      }
    }
  }
}
