{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenDidactiaEsquemaSituacionAprendizaje",
  "description": "Esquema OKF enriquecido según las directrices oficiales de Canarias para el diseño y validación de Situaciones de Aprendizaje competenciales con DUA granular, fases de Merrill y rúbricas con graduadores.",
  "type": "object",
  "required": [
    "identificacion",
    "fundamentacion_y_reto",
    "concrecion_curricular_y_deconstruccion",
    "secuencia_didactica_merrill_dua",
    "evaluacion_formativa_y_rubricas",
    "atencion_a_la_diversidad_medidas_apoyo"
  ],
  "properties": {
    "identificacion": {
      "type": "object",
      "required": [
        "numero_sa",
        "titulo",
        "comunidad_autonoma",
        "etapa",
        "curso",
        "area_o_materia",
        "temporalizacion_sesiones",
        "trimestre"
      ],
      "properties": {
        "numero_sa": { "type": "integer" },
        "titulo": { "type": "string" },
        "comunidad_autonoma": {
          "type": "string",
          "enum": ["Canarias", "Madrid", "Andalucía", "Estatal"]
        },
        "etapa": {
          "type": "string",
          "enum": [
            "Educación Infantil",
            "Educación Primaria",
            "Educación Secundaria Obligatoria",
            "Bachillerato",
            "Formación Profesional"
          ]
        },
        "curso": { "type": "string" },
        "area_o_materia": { "type": "string" },
        "temporalizacion_sesiones": { "type": "integer" },
        "trimestre": {
          "type": "string",
          "enum": ["1.º Trimestre", "2.º Trimestre", "3.º Trimestre"]
        },
        "planes_y_programas_vinculados": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "fundamentacion_y_reto": {
      "type": "object",
      "required": [
        "centro_de_interes",
        "reto_pregunta_motriz",
        "producto_o_desempeno_final"
      ],
      "properties": {
        "centro_de_interes": { "type": "string" },
        "reto_pregunta_motriz": { "type": "string" },
        "producto_o_desempeno_final": { "type": "string" },
        "contexto_autonomico_canario": { "type": "string" },
        "vinculacion_efemerides_calendario": { "type": "string" }
      }
    },
    "concrecion_curricular_y_deconstruccion": {
      "type": "object",
      "required": [
        "competencias_especificas",
        "deconstruccion_criterios_e_instrumentos",
        "saberes_basicos"
      ],
      "properties": {
        "competencias_especificas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["codigo", "enunciado"],
            "properties": {
              "codigo": { "type": "string" },
              "enunciado": { "type": "string" }
            }
          }
        },
        "deconstruccion_criterios_e_instrumentos": {
          "type": "array",
          "description": "Desglose obligatorio según el protocolo oficial de Canarias.",
          "items": {
            "type": "object",
            "required": [
              "criterio_codigo",
              "criterio_texto_completo",
              "instrumentos_productos"
            ],
            "properties": {
              "criterio_codigo": { "type": "string" },
              "criterio_texto_completo": { "type": "string" },
              "instrumentos_productos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "codigo_producto",
                    "nombre_producto",
                    "parte_criterio_evaluada",
                    "descriptores_asignados"
                  ],
                  "properties": {
                    "codigo_producto": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "nombre_producto": { "type": "string" },
                    "parte_criterio_evaluada": { "type": "string" },
                    "descriptores_asignados": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "saberes_basicos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bloque", "saberes"],
            "properties": {
              "bloque": { "type": "string" },
              "saberes": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "secuencia_didactica_merrill_dua": {
      "type": "array",
      "description": "Secuencia de sesiones estructurada bajo los 5 principios de David Merrill y DUA granular.",
      "items": {
        "type": "object",
        "required": [
          "numero_sesion",
          "fase_merrill",
          "tareas"
        ],
        "properties": {
          "numero_sesion": { "type": "integer" },
          "fase_merrill": {
            "type": "string",
            "enum": [
              "Fase 1: Tarea / Problema Central",
              "Fase 2: Activación de Experiencias Previas",
              "Fase 3: Demostración / Modelado",
              "Fase 4: Aplicación Guiada",
              "Fase 5: Integración y Transferencia"
            ]
          },
          "tareas": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "numero_tarea",
                "titulo",
                "duracion_minutos",
                "rol_docente",
                "rol_alumnado",
                "rutina_o_dinamica",
                "agrupamiento",
                "dua_granular"
              ],
              "properties": {
                "numero_tarea": { "type": "string" },
                "titulo": { "type": "string" },
                "duracion_minutos": { "type": "integer" },
                "rol_docente": { "type": "string" },
                "rol_alumnado": { "type": "string" },
                "rutina_o_dinamica": { "type": "string" },
                "agrupamiento": {
                  "type": "string",
                  "enum": ["Individual", "Parejas", "Pequeño grupo cooperativo", "Gran grupo"]
                },
                "dua_granular": {
                  "type": "object",
                  "required": ["representacion", "accion_expresion", "implicacion"],
                  "properties": {
                    "representacion": { "type": "string" },
                    "accion_expresion": { "type": "string" },
                    "implicacion": { "type": "string" }
                  }
                },
                "instrumento_evaluado_producto": { "type": "string" },
                "recursos_y_materiales": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "evaluacion_formativa_y_rubricas": {
      "type": "array",
      "description": "Rúbricas oficiales de Canarias con graduadores y ejemplos por nivel.",
      "items": {
        "type": "object",
        "required": [
          "instrumento_codigo",
          "criterio_asociado",
          "dimension_evaluada",
          "niveles"
        ],
        "properties": {
          "instrumento_codigo": { "type": "string" },
          "criterio_asociado": { "type": "string" },
          "dimension_evaluada": {
            "type": "string",
            "enum": [
              "Calidad y Precisión",
              "Autonomía",
              "Profundidad y Complejidad (Transferencia)",
              "Actitud y Frecuencia"
            ]
          },
          "niveles": {
            "type": "object",
            "required": [
              "insuficiente_1_4",
              "suficiente_bien_5_6",
              "notable_7_8",
              "sobresaliente_9_10"
            ],
            "properties": {
              "insuficiente_1_4": {
                "type": "object",
                "required": ["descriptor_con_graduadores", "ejemplo_producto"],
                "properties": {
                  "descriptor_con_graduadores": { "type": "string" },
                  "ejemplo_producto": { "type": "string" }
                }
              },
              "suficiente_bien_5_6": {
                "type": "object",
                "required": ["descriptor_con_graduadores", "ejemplo_producto"],
                "properties": {
                  "descriptor_con_graduadores": { "type": "string" },
                  "ejemplo_producto": { "type": "string" }
                }
              },
              "notable_7_8": {
                "type": "object",
                "required": ["descriptor_con_graduadores", "ejemplo_producto"],
                "properties": {
                  "descriptor_con_graduadores": { "type": "string" },
                  "ejemplo_producto": { "type": "string" }
                }
              },
              "sobresaliente_9_10": {
                "type": "object",
                "required": ["descriptor_con_graduadores", "ejemplo_producto"],
                "properties": {
                  "descriptor_con_graduadores": { "type": "string" },
                  "ejemplo_producto": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "atencion_a_la_diversidad_medidas_apoyo": {
      "type": "object",
      "required": ["medidas_dua_universales"],
      "properties": {
        "medidas_dua_universales": { "type": "string" },
        "medidas_especificas_neae": { "type": "string" },
        "prevision_plan_apoyo_refuerzo": { "type": "string" }
      }
    }
  }
}
